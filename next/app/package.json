{
  "name": "fardesk",
  "productName": "FarDesk",
  "version": "0.4.0",
  "private": true,
  "description": "FarDesk uzak masaüstü",
  "author": "FarDesk",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/input.js && node --check src/access.js && node --check src/files.js && node --check src/request-preload.js && node --check src/renderer/request.js && node --check src/renderer/label.js && node --check src/renderer/renderer.js && node --check build/after-pack.js",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "dependencies": {
    "@jitsi/robotjs": "0.6.24",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.fardesk.app",
    "productName": "FarDesk",
    "copyright": "Copyright © 2026 FarDesk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@jitsi/robotjs/**/*"
    ],
    "npmRebuild": false,
    "afterPack": "build/after-pack.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/tuncer4427/freedesk/releases/download/fardesk-latest/"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "FarDesk-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "FarDesk"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "FarDesk-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "FarDesk uzaktan kontrol için bu izne ihtiyaç duyar.",
        "NSMicrophoneUsageDescription": "FarDesk sesli görüşme için mikrofonu kullanır."
      }
    },
    "dmg": {
      "sign": false
    }
  }
}
